---
import type { SeoPage } from '../data/seo-pages';
import { site } from '../config';
import ContactDock from './ContactDock.astro';
import Icon from './Icon.astro';
import SiteFooter from './SiteFooter.astro';

interface Props {
  page: SeoPage;
}

const { page } = Astro.props;
---

<ContactDock />

<div class="w-full max-w-[1440px] mx-auto bg-white overflow-hidden">
  <header class="w-full bg-[#0B1020] px-5 sm:px-8 lg:px-12 3xl:px-[72px] py-5">
    <div class="w-full flex items-center justify-between gap-6">
      <a href="/" class="u-icon-host flex items-center gap-[10px] shrink-0" aria-label="Ir al inicio de GUBA ESTUDIO LAB">
        <span aria-hidden="true" class="u-icon-pop block w-[13px] h-[27px] bg-[#C8FF2E]"></span>
        <span class="text-[20px]/[1] sm:text-[23px]/[1] text-white font-[Anton,system-ui,sans-serif] tracking-[0.5px] whitespace-nowrap">
          GUBA ESTUDIO LAB
        </span>
      </a>

      <nav aria-label="Navegación principal" class="hidden lg:flex items-center gap-8">
        <a href="/#servicios" class="u-link text-[14px] text-[#C9D1E3] font-['Funnel_Sans',system-ui,sans-serif] font-semibold">Servicios</a>
        <a href="/#trabajo" class="u-link text-[14px] text-[#C9D1E3] font-['Funnel_Sans',system-ui,sans-serif] font-semibold">Proyectos</a>
        <a href="/#proceso" class="u-link text-[14px] text-[#C9D1E3] font-['Funnel_Sans',system-ui,sans-serif] font-semibold">Proceso</a>
      </nav>

      <a
        href={site.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="u-btn u-btn--lime bg-[#C8FF2E] text-[#0B1020] rounded-full px-4 sm:px-5 py-3 text-[13px] sm:text-[14px] font-['Funnel_Sans',system-ui,sans-serif] font-extrabold whitespace-nowrap"
      >
        Cotizar proyecto
      </a>
    </div>
  </header>

  <main>
    <section class="relative overflow-hidden bg-[#0062FF] px-5 sm:px-8 lg:px-12 3xl:px-[120px] pt-9 sm:pt-12 lg:pt-16 pb-16 sm:pb-20 lg:pb-24">
      <div aria-hidden="true" class="absolute right-[-90px] top-[-70px] size-[280px] sm:size-[380px] rounded-full border-[52px] sm:border-[72px] border-[#FFFFFF12]"></div>
      <div aria-hidden="true" class="absolute right-7 bottom-0 w-[18px] h-[110px] bg-[#C8FF2E]"></div>

      <nav aria-label="Migas de pan" class="relative z-[1] mb-12 sm:mb-16">
        <ol class="flex flex-wrap items-center gap-2 text-[12px] text-[#FFFFFFB8] font-['Geist_Mono',system-ui,sans-serif]">
          <li><a href="/" class="hover:text-white transition-colors">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-white">{page.serviceType}</li>
        </ol>
      </nav>

      <div class="relative z-[1] max-w-[1120px]">
        <p class="mb-5 text-[11px] sm:text-[12px] text-[#C8FF2E] font-['Geist_Mono',system-ui,sans-serif] font-bold tracking-[1px]">
          {page.label}
        </p>
        <h1 class="max-w-[1050px] text-[clamp(42px,7vw,88px)]/[0.98] text-white font-[Anton,system-ui,sans-serif] font-normal tracking-[-0.02em] [text-wrap:balance]">
          {page.heading}
        </h1>
        <p class="mt-7 max-w-[760px] text-[18px]/[27px] sm:text-[22px]/[32px] text-[#FFFFFFE6] font-['Funnel_Sans',system-ui,sans-serif] [text-wrap:pretty]">
          {page.lead}
        </p>
        <div class="mt-9 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a
            href={site.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="u-btn u-btn--lime u-arrow-host flex items-center justify-center gap-3 bg-[#C8FF2E] text-[#0B1020] rounded-full px-6 py-4 text-[16px] font-['Funnel_Sans',system-ui,sans-serif] font-extrabold"
          >
            Pedir una cotización
            <Icon name="arrow-up-right" fill="#0B1020" class="u-arrow w-[18px] h-[18px]" />
          </a>
          <a
            href="/#trabajo"
            class="u-btn u-btn--ghost flex items-center justify-center rounded-full px-6 py-4 [outline:1px_solid_#FFFFFF80] [outline-offset:-1px] text-white text-[16px] font-['Funnel_Sans',system-ui,sans-serif] font-bold"
          >
            Ver proyectos realizados
          </a>
        </div>
      </div>
    </section>

    <section class="px-5 sm:px-8 lg:px-12 3xl:px-[120px] py-16 sm:py-20 lg:py-28 bg-white">
      <div class="grid lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-10 lg:gap-20 items-start">
        <h2 class="text-[clamp(34px,4.6vw,64px)]/[1.02] text-[#151515] font-[Anton,system-ui,sans-serif] font-normal [text-wrap:balance]">
          {page.introHeading}
        </h2>
        <div class="max-w-[70ch] flex flex-col gap-5">
          {page.intro.map((paragraph) => (
            <p class="text-[17px]/[28px] sm:text-[19px]/[31px] text-[#394150] font-['Funnel_Sans',system-ui,sans-serif] [text-wrap:pretty]">
              {paragraph}
            </p>
          ))}
        </div>
      </div>
    </section>

    <section class="px-5 sm:px-8 lg:px-12 3xl:px-[120px] py-16 sm:py-20 lg:py-28 bg-[#0B1020] text-white">
      <div class="max-w-[820px] mb-10 sm:mb-14">
        <h2 class="text-[clamp(34px,4.6vw,64px)]/[1.02] font-[Anton,system-ui,sans-serif] font-normal [text-wrap:balance]">
          {page.idealForHeading}
        </h2>
        <p class="mt-5 text-[17px]/[27px] sm:text-[19px]/[30px] text-[#C9D1E3] font-['Funnel_Sans',system-ui,sans-serif] [text-wrap:pretty]">
          {page.idealForIntro}
        </p>
      </div>

      <ul class="grid md:grid-cols-2 border-t border-[#FFFFFF24]">
        {page.idealFor.map((item, index) => (
          <li class:list={[
            'py-7 sm:py-9 border-b border-[#FFFFFF24]',
            index % 2 === 0 ? 'md:pr-10' : 'md:pl-10 md:border-l',
          ]}>
            <div class="flex items-start gap-5">
              <span class="mt-1 text-[12px] text-[#C8FF2E] font-['Geist_Mono',system-ui,sans-serif] font-bold">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-[22px]/[27px] sm:text-[25px]/[31px] font-['Funnel_Sans',system-ui,sans-serif] font-extrabold">
                  {item.title}
                </h3>
                <p class="mt-3 max-w-[56ch] text-[16px]/[25px] text-[#AEB8CA] font-['Funnel_Sans',system-ui,sans-serif] [text-wrap:pretty]">
                  {item.text}
                </p>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="px-5 sm:px-8 lg:px-12 3xl:px-[120px] py-16 sm:py-20 lg:py-28 bg-white">
      <div class="grid lg:grid-cols-[minmax(280px,0.75fr)_minmax(0,1.25fr)] gap-10 lg:gap-20">
        <div>
          <h2 class="text-[clamp(34px,4.2vw,58px)]/[1.03] text-[#151515] font-[Anton,system-ui,sans-serif] font-normal [text-wrap:balance]">
            {page.includesHeading}
          </h2>
          <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="u-arrow-host mt-7 inline-flex items-center gap-3 text-[16px] text-[#0062FF] font-['Funnel_Sans',system-ui,sans-serif] font-extrabold">
            Consultar este servicio
            <Icon name="move-right" fill="#0062FF" class="u-arrow--right w-[18px] h-[18px]" />
          </a>
        </div>

        <ol class="border-t border-[#CAD2E0]">
          {page.includes.map((item, index) => (
            <li class="grid sm:grid-cols-[54px_0.7fr_1.3fr] gap-3 sm:gap-6 py-6 sm:py-7 border-b border-[#CAD2E0]">
              <span class="text-[12px] text-[#0062FF] font-['Geist_Mono',system-ui,sans-serif] font-bold">
                {String(index + 1).padStart(2, '0')}
              </span>
              <h3 class="text-[18px]/[24px] text-[#151515] font-['Funnel_Sans',system-ui,sans-serif] font-extrabold">
                {item.title}
              </h3>
              <p class="text-[16px]/[25px] text-[#4B5563] font-['Funnel_Sans',system-ui,sans-serif] [text-wrap:pretty]">
                {item.text}
              </p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="px-5 sm:px-8 lg:px-12 3xl:px-[120px] py-16 sm:py-20 lg:py-24 bg-[#EEF4FF]">
      <div class="max-w-[980px]">
        <h2 class="text-[clamp(34px,4.6vw,64px)]/[1.02] text-[#151515] font-[Anton,system-ui,sans-serif] font-normal [text-wrap:balance]">
          {page.decisionHeading}
        </h2>
        <div class="mt-8 grid md:grid-cols-2 gap-6 md:gap-10">
          {page.decision.map((paragraph) => (
            <p class="text-[17px]/[28px] sm:text-[18px]/[29px] text-[#394150] font-['Funnel_Sans',system-ui,sans-serif] [text-wrap:pretty]">
              {paragraph}
            </p>
          ))}
        </div>
      </div>
    </section>

    <section class="px-5 sm:px-8 lg:px-12 3xl:px-[120px] py-16 sm:py-20 lg:py-28 bg-white">
      <div class="grid lg:grid-cols-[0.7fr_1.3fr] gap-10 lg:gap-20">
        <h2 class="text-[clamp(34px,4.2vw,58px)]/[1.03] text-[#151515] font-[Anton,system-ui,sans-serif] font-normal">
          PREGUNTAS SOBRE EL SERVICIO
        </h2>
        <div class="border-t border-[#CAD2E0]">
          {page.faqs.map((item, index) => (
            <details class="group border-b border-[#CAD2E0]" open={index === 0}>
              <summary class="flex items-start justify-between gap-6 py-6 sm:py-7 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <h3 class="text-[18px]/[26px] sm:text-[21px]/[29px] text-[#151515] font-['Funnel_Sans',system-ui,sans-serif] font-extrabold">
                  {item.question}
                </h3>
                <span aria-hidden="true" class="text-[26px]/[1] text-[#0062FF] font-['Geist_Mono',system-ui,sans-serif] group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="max-w-[70ch] pb-7 text-[16px]/[27px] sm:text-[17px]/[28px] text-[#4B5563] font-['Funnel_Sans',system-ui,sans-serif] [text-wrap:pretty]">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="px-5 sm:px-8 lg:px-12 3xl:px-[120px] py-16 sm:py-20 bg-[#0062FF] text-white">
      <div class="flex flex-col lg:flex-row gap-8 lg:gap-16 justify-between lg:items-end">
        <div class="max-w-[720px]">
          <h2 class="text-[clamp(36px,5vw,68px)]/[1] font-[Anton,system-ui,sans-serif] font-normal [text-wrap:balance]">
            EXPLORA LA SOLUCIÓN QUE MEJOR ENCAJA
          </h2>
          <p class="mt-5 text-[18px]/[28px] text-[#FFFFFFD9] font-['Funnel_Sans',system-ui,sans-serif]">
            Compara alcances antes de decidir. Si todavía no está claro, cuéntanos qué necesitas comunicar, publicar o gestionar.
          </p>
        </div>
        <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="u-btn u-btn--lime shrink-0 inline-flex justify-center bg-[#C8FF2E] text-[#0B1020] rounded-full px-6 py-4 text-[16px] font-['Funnel_Sans',system-ui,sans-serif] font-extrabold">
          Explicar mi proyecto
        </a>
      </div>

      <div class="mt-10 grid md:grid-cols-3 border-t border-[#FFFFFF40]">
        {page.related.map((link, index) => (
          <a href={link.href} class:list={[
            'u-arrow-host group py-7 md:py-8 border-b border-[#FFFFFF40]',
            index > 0 ? 'md:pl-7 md:border-l' : 'md:pr-7',
          ]}>
            <span class="flex items-center justify-between gap-4 text-[20px]/[25px] font-['Funnel_Sans',system-ui,sans-serif] font-extrabold">
              {link.label}
              <Icon name="move-right" fill="#C8FF2E" class="u-arrow--right w-[20px] h-[20px] shrink-0" />
            </span>
            <span class="block mt-3 text-[15px]/[23px] text-[#FFFFFFB8] font-['Funnel_Sans',system-ui,sans-serif]">
              {link.text}
            </span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <SiteFooter />
</div>
