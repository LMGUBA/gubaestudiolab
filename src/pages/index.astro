---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectShowcase from '../components/ProjectShowcase.astro';
import Services from '../components/Services.astro';
import ClientProof from '../components/ClientProof.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyNav from '../components/StickyNav.astro';
import BackToTop from '../components/BackToTop.astro';
import ContactDock from '../components/ContactDock.astro';
---

<Layout
  title="GUBA ESTUDIO LAB | Diseño y desarrollo web en Perú"
  description="GUBA ESTUDIO LAB es un estudio web en Pucallpa, Perú. Diseñamos páginas web estáticas que comunican con claridad y plataformas dinámicas para operar y escalar."
>
  <StickyNav />
  <BackToTop />
  <ContactDock />
  <div
    class="box-border w-full max-w-[1440px] mx-auto h-fit flex flex-col gap-0 justify-start items-start bg-[#FFFFFF] overflow-hidden"
  >
    <Hero />
    <ProjectShowcase />
    <Services />
    <ClientProof />
    <Process />
    <Faq />
    <FinalCta />
    <SiteFooter />
  </div>
</Layout>
